FROM vito-docker.artifactory.vgt.vito.be/almalinux9-spark4-py311-openeo:latest
RUN dnf upgrade -y gdal-3.11.3-2025.11.21 gdal-libs-3.11.3-2025.11.21 gdal-devel-3.11.3-2025.11.21 gdal-python311-3.11.3-2025.11.21 && dnf clean all
RUN dnf install -y maven java-21-openjdk-devel git dnf-plugins-core
RUN dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
RUN dnf install -y docker-ce
RUN update-alternatives --set javac java-21-openjdk.x86_64
RUN update-alternatives --set java java-21-openjdk.x86_64
RUN export JAVA_HOME=$(which java)
USER jenkins
